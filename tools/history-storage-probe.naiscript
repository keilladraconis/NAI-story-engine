/*---
compatibilityVersion: naiscript-1.0
id: 02187497-3d1d-4675-9b32-56782994db3c
name: History Storage Probe
version: 0.1.0
description: Does historyStorage.list() return inherited ancestor keys, or only keys written at that exact node?
memoryLimit: 8
---*/

// Press Write markers, add a generation or two in the editor, press Write markers
// again, then press Check. Repeat as you like — the ledger accumulates.
//
// Each Write stamps two things at the current node:
//   marker-N  a key unique to that node
//   shared    the same key every time, so get() shows which ancestor wins
//
// Check answers three questions:
//   1. does list() here include keys written at ancestor nodes?
//   2. does get() resolve keys written at ancestor nodes?
//   3. which node does the shared key resolve to?
//
// The ledger lives in storyStorage on purpose. historyStorage is what we are
// testing, so keeping our own bookkeeping there would bury the result.

const LEDGER = "history-probe-ledger";

const currentNode = () => api.v1.document.history.currentNodeId();

let report = "";

function log(line) {
  report += line + "\n";
  api.v1.log(line);
  void api.v1.ui.updateParts([{ id: "report", text: report }]);
}

async function readLedger() {
  return (await api.v1.storyStorage.get(LEDGER)) || [];
}

async function writeMarkers() {
  const node = await currentNode();
  const ledger = await readLedger();
  const key = `marker-${ledger.length + 1}`;

  await api.v1.historyStorage.set(key, { writtenAt: node });
  await api.v1.historyStorage.set("shared", { writtenAt: node });
  await api.v1.storyStorage.set(LEDGER, ledger.concat([{ key, node }]));

  log(`wrote ${key} and shared at node ${node} (${typeof node})`);
}

async function check() {
  const node = await currentNode();
  const ledger = await readLedger();
  const here = await api.v1.historyStorage.list();

  log(`\n--- check at node ${node} ---`);
  log(`list() here: ${JSON.stringify(here)}`);

  const ancestors = ledger.filter((entry) => entry.node !== node);

  for (const entry of ledger) {
    const value = await api.v1.historyStorage.get(entry.key);
    const has = await api.v1.historyStorage.has(entry.key);
    const atNode = await api.v1.historyStorage.list(entry.node);
    log(
      `  ${entry.key} written@${entry.node}` +
        `  get=${value ? `writtenAt ${value.writtenAt}` : "MISSING"}` +
        `  has=${has}` +
        `  list@${entry.node}=${JSON.stringify(atNode)}`,
    );
  }

  const shared = await api.v1.historyStorage.get("shared");
  log(`  shared resolves to node ${shared ? shared.writtenAt : "MISSING"}`);

  if (ancestors.length === 0) {
    log("verdict: write markers, add a generation, then check again");
    return;
  }

  const visible = ancestors.filter((entry) => here.includes(entry.key));
  if (visible.length === ancestors.length) {
    log("verdict: list() INHERITS ancestor keys");
  } else if (visible.length === 0) {
    log("verdict: list() is NODE-LOCAL (get() still inherits)");
  } else {
    log(`verdict: mixed — ${visible.length}/${ancestors.length} ancestor keys listed`);
  }
}

async function clear() {
  const ledger = await readLedger();
  for (const entry of ledger) await api.v1.historyStorage.remove(entry.key);
  await api.v1.historyStorage.remove("shared");
  await api.v1.storyStorage.remove(LEDGER);
  report = "";
  log("cleared");
}

// Also settles whether nodeId is a string or a number: the hook types it as
// string, while currentNodeId() returns number.
api.v1.hooks.register("onHistoryNavigated", async (params) => {
  const node = await currentNode();
  log(
    `\nnavigated ${params.cause}: hook nodeId=${params.nodeId} (${typeof params.nodeId})` +
      `  currentNodeId=${node} (${typeof node})`,
  );
});

api.v1.ui.register([
  api.v1.ui.extension.scriptPanel({
    name: "History Storage Probe",
    content: [
      api.v1.ui.part.column({
        content: [
          api.v1.ui.part.button({
            text: "Write markers",
            callback: () => void writeMarkers(),
            disabledWhileCallbackRunning: true,
          }),
          api.v1.ui.part.button({
            text: "Check",
            callback: () => void check(),
            disabledWhileCallbackRunning: true,
          }),
          api.v1.ui.part.button({
            text: "Clear",
            callback: () => void clear(),
            disabledWhileCallbackRunning: true,
          }),
          api.v1.ui.part.text({
            id: "report",
            text: "Write markers, generate a paragraph, write markers again, check.",
            noTemplate: true,
            style: { whiteSpace: "pre-wrap", userSelect: "text" },
          }),
        ],
      }),
    ],
  }),
]);
