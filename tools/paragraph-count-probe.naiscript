/*---
compatibilityVersion: naiscript-1.0
id: 3a7c1f95-6b28-4d03-9e14-c5f8a2b70d61
name: Paragraph Count Probe
version: 0.2.0
description: Does NovelAI's paragraphCount condition variable count what document.scan() counts?
memoryLimit: 8
---*/

// Story Engine's thread anchor is a paragraph INDEX, and both things that read it
// compare it against NovelAI's own `paragraphCount`:
//
//   * the pacing gate baked into every thread entry's advancedConditions —
//     `paragraphCount >= anchor + grace`
//   * expiry, which measures `Assessment.paragraphCount - thread.anchorParagraph`
//
// `Assessment.paragraphCount` is `api.v1.document.scan().length`. Nothing has ever
// checked that NovelAI counts the same way. If its `paragraphCount` is smaller —
// context-scoped, say, or skipping blanks — every gate reads as not-yet-reached and
// the threads go SILENT, which §4.3 says never to accept. (A gate that is always
// TRUE only degrades to the old always-on, which is survivable.)
//
// No generation, no output budget. `buildContext()` runs the real context builder
// and our own `onContextBuilt` hook sees the entry's `active` flag — the answer read
// directly, rather than inferred from what a model wrote.
//
// METHOD. **One** probe entry, gated on `paragraphCount >= k` in the same
// single-term shape `paceGate` emits in production. Binary search k by rewriting
// that one entry's target and rebuilding the context — about eight rounds for any
// realistic story. v0.1 minted one entry per candidate instead, which meant a
// hundred-odd `createEntry` round trips into the writer's own lorebook before a
// single answer came back. One entry is lighter, faster, and leaves far less behind
// if the run is interrupted.
//
// Run:
//   1. Open a story with some prose in it (20+ paragraphs is a better test than 3).
//   2. Probe    — searches and reports.
//   3. Clean up — removes the entry and its category.

const CATEGORY = "PROBE: paragraphCount";
const LEDGER = "paragraph-count-probe";

// `createEntry` and `createCategory` are gated on this. v0.1 omitted the request
// and every run died inside `ensureCategory` with the report frozen two lines in.
api.v1.permissions.request(["lorebookEdit"]);

let report = "";

function log(line) {
  report += line + "\n";
  api.v1.log(line);
  void api.v1.ui.updateParts([{ id: "report", text: report }]);
}

// The hook is how activation is read. `api.v1.hooks.register` holds ONE callback
// per hook name, so a probe must be the only thing registering it — which it is,
// running alone in a scratch story.
let seen = null;
api.v1.hooks.register("onContextBuilt", (params) => {
  seen = params.lorebookEntries;
});

function gate(k) {
  return [
    {
      type: "equation",
      terms: [{ value: "paragraphCount" }],
      comparison: ">=",
      target: k,
    },
  ];
}

/** Is `paragraphCount >= k`? Rewrites the probe's gate and rebuilds. */
async function holdsAt(entryId, k) {
  await api.v1.lorebook.updateEntry(entryId, { advancedConditions: gate(k) });
  seen = null;
  await api.v1.buildContext();
  if (!seen) throw new Error("onContextBuilt did not fire");
  const row = seen.find(([id]) => id === entryId);
  if (!row) throw new Error("the probe entry was not in the built context");
  return row[1].active === true;
}

async function ensureCategory() {
  const categories = await api.v1.lorebook.categories();
  const found = categories.find((c) => c.name === CATEGORY);
  if (found) return found.id;
  return await api.v1.lorebook.createCategory({
    id: api.v1.uuid(),
    name: CATEGORY,
    enabled: true,
  });
}

async function run() {
  report = "";

  const sections = await api.v1.document.scan();
  const scanTotal = sections.length;
  const scanNonEmpty = sections.filter(
    (s) => (s.section.text || "").trim().length > 0,
  ).length;
  const scanChars = sections.reduce(
    (n, s) => n + (s.section.text || "").length,
    0,
  );

  log(`document.scan(): ${scanTotal} sections, ${scanNonEmpty} with prose`);
  log(`                ${scanChars} characters total`);

  if (scanTotal === 0) {
    log("");
    log("Nothing written. Open a story with prose in it and run again.");
    return;
  }

  const categoryId = await ensureCategory();
  const entryId = await api.v1.lorebook.createEntry({
    id: api.v1.uuid(),
    displayName: "paragraphCount probe",
    text: "paragraphCount probe",
    keys: [],
    enabled: true,
    forceActivation: true,
    category: categoryId,
    advancedConditions: gate(1),
  });
  await api.v1.storyStorage.set(LEDGER, { entryId });
  log("");
  log("searching…");

  // `paragraphCount >= 0` is true of any count and proves nothing, so the search
  // starts at 1. `hi` climbs until the gate fails, which also catches a count far
  // larger than the document (context-scoped counters can only be smaller, but a
  // surprise is what this is for).
  let hi = 1;
  while (await holdsAt(entryId, hi)) {
    if (hi > scanTotal * 4 + 100) break;
    hi *= 2;
  }
  let lo = Math.floor(hi / 2);
  while (lo + 1 < hi) {
    const mid = Math.floor((lo + hi) / 2);
    if (await holdsAt(entryId, mid)) lo = mid;
    else hi = mid;
  }
  // `lo` holds and `lo + 1` does not, so the count is exactly `lo` — unless the
  // gate never held at all, which means a count below 1.
  const count = (await holdsAt(entryId, 1)) ? lo : 0;

  log("");
  log(`NovelAI paragraphCount = ${count}`);
  log(`document.scan() total  = ${scanTotal}`);
  log(`document.scan() prose  = ${scanNonEmpty}`);
  log("");

  if (count === scanTotal) {
    log("VERDICT: AGREES with document.scan().length.");
    log("Assessment.paragraphCount is the right unit. Nothing to change.");
  } else if (count === scanNonEmpty) {
    log("VERDICT: counts only paragraphs with prose in them.");
    log("Assessment.paragraphCount counts every section, so it runs AHEAD.");
    log("An anchor would sit in the future and its gate would never open —");
    log("threads go silent. assess.ts must count non-empty sections instead.");
  } else if (count < scanTotal) {
    log(`VERDICT: DISAGREES — NovelAI counts ${scanTotal - count} fewer.`);
    log("Likely context-scoped rather than document-scoped. Our anchor would sit");
    log("in the future and gated threads would never fire. This is the failure");
    log("direction §4.3 refuses; the anchor needs to be in NovelAI's unit.");
  } else {
    log(`VERDICT: DISAGREES — NovelAI counts ${count - scanTotal} MORE.`);
    log("Gates open early. Survivable (degrades toward always-on), but the grace");
    log("window is not the length it claims to be.");
  }

  log("");
  log("Now press Clean up.");
}

async function cleanUp() {
  const ledger = await api.v1.storyStorage.get(LEDGER);
  report = "";
  if (ledger && ledger.entryId) {
    await api.v1.lorebook.removeEntry(ledger.entryId);
    log("removed the probe entry");
  }
  const categories = await api.v1.lorebook.categories();
  const category = categories.find((c) => c.name === CATEGORY);
  if (category) {
    await api.v1.lorebook.removeCategory(category.id);
    log(`removed the ${CATEGORY} category`);
  }
  await api.v1.storyStorage.remove(LEDGER);
  log("done");
}

/** Nothing here may fail silently. v0.1 called `run()` bare, so the permission
 *  error surfaced as a report that simply stopped mid-way — indistinguishable
 *  from a slow run, and the one thing a probe must never be is quiet about its
 *  own failure. */
function guard(fn) {
  return () => {
    void (async () => {
      try {
        await fn();
      } catch (error) {
        log("");
        log(`FAILED: ${(error && error.message) || String(error)}`);
        log("Press Clean up, then read the script log.");
      }
    })();
  };
}

api.v1.ui.register([
  api.v1.ui.extension.scriptPanel({
    name: "Paragraph Count Probe",
    content: [
      api.v1.ui.part.column({
        content: [
          api.v1.ui.part.button({
            text: "1. Probe",
            callback: guard(run),
            disabledWhileCallbackRunning: true,
          }),
          api.v1.ui.part.button({
            text: "2. Clean up",
            callback: guard(cleanUp),
            disabledWhileCallbackRunning: true,
          }),
          api.v1.ui.part.text({
            id: "report",
            text: "Open a story with prose, then Probe. Clean up afterwards.",
            noTemplate: true,
            style: { whiteSpace: "pre-wrap", userSelect: "text" },
          }),
        ],
      }),
    ],
  }),
]);
